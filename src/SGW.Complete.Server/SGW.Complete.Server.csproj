<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SGW.Complete.Server</AssemblyName>
    <RootNamespace>SGW.Complete.Server</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Sönmez Game World</Authors>
    <Description>SGW Complete Plugin - CarSwap, WheelSwap, Stance, SkinSwap, RacePlugin</Description>
    <Copyright>2025 Sönmez Game World</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssettoServer.Server" Version="0.0.55-preview.44" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
